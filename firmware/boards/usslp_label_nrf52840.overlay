/*
 * USSLP Tier 1 smart shelf label, nRF52840 revision C.
 *
 * The board:
 *   nRF52840        application MCU, 1 MB flash / 256 KB RAM, BLE 5.0
 *   CC2652P         802.15.4 / Zigbee 3.0 co-processor over UART with a
 *                   hardware handshake, so the nRF can sleep while the radio
 *                   holds its receive window open
 *   SSD1683-class   E-Ink panel controller over SPI
 *   ST25DV04K       dynamic NFC tag over I2C, field powered for reads
 *   LIS2DH12        accelerometer for tamper detection, interrupt driven
 *   BQ25125         PMIC with a boost for the E-Ink rails and an RF harvest
 *                   input
 *
 * Note on the co-processor split: the nRF52840 has its own 802.15.4 radio, and a
 * single-chip design is cheaper. The CC2652P is there because it can hold a
 * receive window open at 6.5 mA with the nRF in System OFF at 0.8 uA, and the
 * beacon listen is more than half this device's entire energy budget
 * (power/usslp_budget.h). Splitting the radio out is the reason the seven-year
 * figure is reachable at all.
 */

/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		usslp,eink = &eink0;
		usslp,pmic = &pmic0;
		usslp,nfc-tag = &nfctag0;
		usslp,accel = &accel0;
		usslp,radio-cp = &uart1;
	};

	aliases {
		eink0 = &eink0;
		pmic0 = &pmic0;
		nfctag0 = &nfctag0;
		accel0 = &accel0;
		locator-led = &led_locator;
	};

	leds {
		compatible = "gpio-leds";

		/* The locator LED is how a picker finds one shelf edge among four
		 * hundred. It is also a measurable battery cost, so it is pulsed for
		 * milliseconds and only when a human is expected to act. */
		led_locator: led_0 {
			gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
			label = "Locator";
		};
	};

	usslp_board {
		compatible = "usslp,label-board";

		/* The E-Ink charge pump rails. The panel draws 26-35 mA while the
		 * waveform runs, which is the largest current this device ever takes,
		 * and the boost has to be up before the first SPI command. */
		panel_power_gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;

		/* The RF harvesting rectifier's output. It is sampled, not relied on:
		 * a label under a reader gate harvests usefully and a label in the
		 * middle of an aisle harvests nothing. */
		harvest_sense = <&adc 2>;
	};
};

&uart0 {
	status = "disabled"; /* the production build consoles over RTT */
};

/* The link to the CC2652P. Hardware flow control matters: the co-processor
 * raises CTS when it has a frame, which is what wakes the nRF from System ON
 * idle without a poll. */
&uart1 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <1000000>;
	hw-flow-control;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};

&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;

	eink0: eink@0 {
		compatible = "usslp,eink-ssd1683";
		reg = <0>;
		/* 4 MHz. The panel controller tolerates 20 MHz, but the framebuffer is
		 * a few kilobytes and pushing it faster saves microseconds against a
		 * waveform that takes 1.5 seconds. Slower edges cost less EMI on a
		 * flexible cable that runs the length of a shelf. */
		spi-max-frequency = <4000000>;
		dc-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
		width = <296>;
		height = <128>;
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	pmic0: bq25125@6a {
		compatible = "ti,bq25125";
		reg = <0x6a>;
		int-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
	};

	nfctag0: st25dv@53 {
		compatible = "st,st25dv";
		reg = <0x53>;
		/* The system-configuration address is a second I2C address on the same
		 * part; the driver needs both. */
		system-reg = <0x57>;
		gpo-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
		size = <512>; /* ST25DV04K: 4 kbit user memory */
	};

	accel0: lis2dh12@19 {
		compatible = "st,lis2dh";
		reg = <0x19>;
		irq-gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;
		/* 10 Hz is enough to see a label being unclipped and is the lowest rate
		 * the part offers above power-down. Tamper detection is a
		 * "did somebody take this off the rail" question, not a motion-capture
		 * problem. */
		anym-on-int1;
	};
};

&adc {
	status = "okay";
};

/*
 * Flash layout for a 1 MB part with MCUboot and two application slots.
 *
 *   0x000000  48 KiB  MCUboot
 *   0x00c000 424 KiB  slot0 (running image)
 *   0x076000 424 KiB  slot1 (staged image)
 *   0x0e0000  96 KiB  ota_scratch (the staged delta patch, memory mapped and
 *                     read directly by the applier)
 *   0x0f8000  24 KiB  storage (NVS: sequence, ghosting counter, key ring,
 *                     provisioning record)
 *   0x0fe000   8 KiB  identity (the device key and certificate, ACL locked at
 *                     boot so nothing after the bootloader can read it)
 *
 * The two application slots have to be the same size because MCUboot swaps
 * them. 424 KiB is generous against the ~180 KiB this application builds to;
 * the headroom is deliberate, because the thing you cannot do in the field is
 * grow a partition.
 */
&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x0000c000>;
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000c000 0x0006a000>;
		};

		slot1_partition: partition@76000 {
			label = "image-1";
			reg = <0x00076000 0x0006a000>;
		};

		ota_scratch_partition: partition@e0000 {
			label = "ota-scratch";
			reg = <0x000e0000 0x00018000>;
		};

		storage_partition: partition@f8000 {
			label = "storage";
			reg = <0x000f8000 0x00006000>;
		};

		identity_partition: partition@fe000 {
			label = "identity";
			reg = <0x000fe000 0x00002000>;
		};
	};
};

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 6)>, <NRF_PSEL(UART_RTS, 0, 5)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 8)>, <NRF_PSEL(UART_CTS, 0, 7)>;
			bias-pull-up;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 6)>, <NRF_PSEL(UART_RX, 0, 8)>,
				<NRF_PSEL(UART_RTS, 0, 5)>, <NRF_PSEL(UART_CTS, 0, 7)>;
			low-power-enable;
		};
	};

	spi1_default: spi1_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 9)>, <NRF_PSEL(SPIM_MOSI, 0, 10)>;
		};
	};

	spi1_sleep: spi1_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 9)>, <NRF_PSEL(SPIM_MOSI, 0, 10)>;
			low-power-enable;
		};
	};

	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 26)>, <NRF_PSEL(TWIM_SCL, 0, 27)>;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 26)>, <NRF_PSEL(TWIM_SCL, 0, 27)>;
			low-power-enable;
		};
	};
};
