# USSLP Shelf Edge Controller configuration.
#
# Install to /etc/usslp/sec.env, owner root:usslp, mode 0640. Per-controller
# overrides go in /etc/usslp/sec-{id}.env, which the templated unit loads after
# this file and which is optional.
#
# USSLP_SEC_ID is NOT set here. The systemd template sets it from the instance
# name (usslp-sec@sec-0001 → USSLP_SEC_ID=sec-0001), which is what makes 25
# controllers on one host a naming decision rather than 25 files.
#
# Four of these are declared Required by edge/cmd/sec/main.go and the binary
# refuses to start without them: SEC_ID, STORE_ID, TENANT_ID, GATEWAY_BROKER_URL
# and KEYRING_FILE.

# ---------------------------------------------------------------------------
# Identity — required
# ---------------------------------------------------------------------------
USSLP_STORE_ID=REPLACE-ME
USSLP_TENANT_ID=REPLACE-ME
USSLP_REGION=us-east-1

USSLP_ENVIRONMENT=prod
USSLP_LOG_LEVEL=info
USSLP_LOG_FORMAT=json

# ---------------------------------------------------------------------------
# The gateway link — required
#
# A controller only ever talks to the broker inside the building. That is not a
# convention, it is the mechanism behind zero label downtime during a WAN
# outage: when the cloud link drops the bridge stops and the local broker does
# not, so the controller never notices.
#
# Pointing this at a cloud broker would work, and would throw away the entire
# offline story.
# ---------------------------------------------------------------------------
USSLP_GATEWAY_BROKER_URL=tcp://sgu.store.local:1883

# ---------------------------------------------------------------------------
# The key ring — required
#
# This is the file the controller verifies price attestations against. It
# recomputes the SHA-256 digest from the update it is holding — never from the
# transmitted digest — and checks the Ed25519 signature against the keys here.
# Failure means the update is dropped, the previous price stays on the glass,
# and a compliance alert is raised.
#
# Consequences worth being explicit about:
#   - a key ring that has not been synced after a key rotation makes the
#     controller refuse every new price, and it will do so silently as far as
#     the shelf is concerned: the old price simply stays;
#   - a key ring an attacker can write is a key ring that can authorise a
#     forged price. Mode 0440, owner root:usslp, on a read-only mount.
# ---------------------------------------------------------------------------
USSLP_KEYRING_FILE=/etc/usslp/secrets/keyring.json

# ---------------------------------------------------------------------------
# Zone
#
# The physical shelf section this controller owns: roughly 8 m of aisle,
# 240 labels. ZONE_LENGTH_M and ZONE_LABELS shape the mesh model — the number
# of hops a frame takes and therefore the 300 ms slice of the price budget this
# hop owns.
# ---------------------------------------------------------------------------
USSLP_ZONE_LABELS=240
USSLP_ZONE_LENGTH_M=24
USSLP_ZONE_SEED=1

# Mesh healing strategy. "predictive" uses sec_mesh_link_failure_risk to move
# routes off a link *before* it fails; the alternative is reactive healing,
# which moves them after. Predictive costs a little CPU and saves the delivery
# that would have been lost.
USSLP_MESH_HEALING=predictive
USSLP_MESH_SAMPLE_INTERVAL=30s

# ---------------------------------------------------------------------------
# Reporting intervals
#
# Telemetry is batched per controller and not per label, and the arithmetic is
# why: 40,000 labels reporting every five minutes is 133 messages/second per
# store, which is 13 million/second across 100,000 stores. Batched per
# controller it is 0.08 messages/second per store.
#
# Shortening TELEMETRY_INTERVAL is therefore a fleet-wide decision, not a
# per-store one.
# ---------------------------------------------------------------------------
USSLP_TELEMETRY_INTERVAL=5m
USSLP_HEARTBEAT_INTERVAL=10s
# Three missed heartbeats is what moves a device to offline in the registry, so
# at 10s a genuinely dead controller is visible within 30 seconds.
USSLP_ACTIVE_WINDOW=5m

# ---------------------------------------------------------------------------
# Admin and state
# ---------------------------------------------------------------------------
# /metrics, /healthz, /readyz. Bound to the store LAN so the gateway's own
# scrape can reach it; the controller has no other listener.
USSLP_ADMIN_ADDR=0.0.0.0:9090
USSLP_ENABLE_PPROF=false
USSLP_TRACE_SAMPLE_ONE_IN=1000

# The templated unit sets StateDirectory=usslp/sec-%i and ReadWritePaths to
# match, so each instance needs its own USSLP_DATA_DIR.
#
# systemd's EnvironmentFile does NOT expand variables — writing
# /var/lib/usslp/sec-${USSLP_SEC_ID} here would set that literal string as the
# path. So this file, which is shared by every instance, sets nothing, and the
# per-instance file /etc/usslp/sec-{id}.env sets it. install.sh writes one per
# controller:
#
#   USSLP_DATA_DIR=/var/lib/usslp/sec-sec-0001
#
# Leaving it unset entirely would fall back to config.LoadService's default of
# ./data, which under ProtectSystem=strict is not writable — so the process
# fails at start-up rather than quietly sharing state between controllers. That
# is the right failure, but it is a failure, so set it.

# Simulation speed. 1 is real time. edge/cmd/sec in this repository drives a
# simulated Zigbee mesh and simulated E-Ink panels; on real hardware this value
# is meaningless and should stay at 1.
USSLP_SIM_SPEED=1

# Drain. Must be shorter than the unit's TimeoutStopSec (30s).
USSLP_SHUTDOWN_GRACE=15s
